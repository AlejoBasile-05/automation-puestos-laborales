<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CV ATS - {{ basics.name }}</title>
    <style>
        body {
            font-family: "Arial", sans-serif;
            font-size: 11pt;
            color: black;
            line-height: 1.2;
            font-variant-ligatures: none;
            margin: 0;
            padding: 20px;
        }
        .section {
            margin-bottom: 15px;
        }
        .section-title {
            font-weight: bold;
            margin-bottom: 5px;
            font-size: 12pt;
        }
        .job-title {
            font-weight: bold;
        }
        .company {
            font-style: italic;
        }
        .dates {
            font-style: italic;
        }
        .bullet {
            margin-left: 20px;
            text-indent: -20px;
            margin-bottom: 3px;
        }
        .bullet::before {
            content: "• ";
        }
    </style>
</head>
<body>
    <div class="section">
        <div class="section-title">{{ basics.name }}</div>
    </div>

    <div class="section">
        <div class="section-title">Contacto</div>
        <div>Email: {{ basics.email }}</div>
        <div>Teléfono: {{ basics.phone }}</div>
        <div>Ubicación: {{ basics.location }}</div>
        {% for link in basics.links %}
        <div>{{ link.label }}: {{ link.url }}</div>
        {% endfor %}
    </div>

    <div class="section">
        <div class="section-title">Resumen</div>
        <div>{{ headline }}</div>
        <div>{{ summary }}</div>
    </div>

    <div class="section">
        <div class="section-title">Habilidades</div>
        <div>{% for skill in skills %}{{ skill }}{% if not loop.last %}, {% endif %}{% endfor %}</div>
    </div>

    <div class="section">
        <div class="section-title">Experiencia profesional</div>
        {% for job in experience %}
        <div class="job">
            <div class="job-title">{{ job.title }}</div>
            <div class="company">{{ job.company }}</div>
            <div class="dates">{{ job.start }} – {{ job.end }}</div>
            <div class="location">{{ job.location }}</div>
            {% for bullet_id in job.bullet_ids %}
            {% set bullet = job.bullets_map[bullet_id] %}
            {% if bullet %}
            <div class="bullet">{{ job.rewrites.get(bullet_id, bullet.text) }}</div>
            {% endif %}
            {% endfor %}
        </div>
        {% endfor %}
    </div>

    <div class="section">
        <div class="section-title">Educación</div>
        {% for edu in education %}
        <div class="education">
            <div>{{ edu.degree }}</div>
            <div>{{ edu.institution }}</div>
            <div class="dates">{{ edu.year }}</div>
        </div>
        {% endfor %}
    </div>

    {% if certifications %}
    <div class="section">
        <div class="section-title">Certificaciones</div>
        {% for cert in certifications %}
        <div class="certification">
            <div>{{ cert }}</div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

    <div class="section">
        <div class="section-title">Idiomas</div>
        {% for lang in languages %}
        <div>{{ lang.name }}: {{ lang.level }}</div>
        {% endfor %}
    </div>
</body>
</html>
